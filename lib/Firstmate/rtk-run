#!/usr/bin/env bash
# fm-rtk.sh - non-executing verification of Firstmate's reviewed RTK artifact.
#
# Usage:
#   fm-rtk.sh verify
#
# The verifier accepts only the pinned private artifact at:
#   $FM_HOME/data/tools/rtk/v0.45.0/aarch64-apple-darwin/rtk
# on Darwin arm64, with SHA-256:
#   17d00d61a533a442c61f1be49d8a9321225557f64021d5b70fd8eb75ed8fb0be
# It walks the absolute home from an opened filesystem root without following
# symlinks, hashes the opened regular executable identity, and never executes,
# copies, stages, activates, installs, downloads, or updates RTK. It runs no
# project command and creates no file.
set -u

SOURCE_PATH=${BASH_SOURCE[0]}
SOURCE_NAME=${SOURCE_PATH##*/}
case "$SOURCE_PATH" in */*) SOURCE_DIR=${SOURCE_PATH%/*} ;; *) SOURCE_DIR=. ;; esac
SCRIPT_DIR=$(CDPATH='' cd -- "$SOURCE_DIR" 2>/dev/null && pwd -P) || exit 70
FM_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIR/../.." 2>/dev/null && pwd -P) || exit 70
RTK_PIN=v0.45.0
RTK_PLATFORM=aarch64-apple-darwin
RTK_BINARY_SHA256=17d00d61a533a442c61f1be49d8a9321225557f64021d5b70fd8eb75ed8fb0be
UNAME_TOOL=/usr/bin/uname
PERL_TOOL=/usr/bin/perl

if [ "$SOURCE_NAME" = fm-rtk-test-driver.sh ]; then
  case "${FM_RTK_TEST_SYSTEM_ROOT:-}" in
    /*) UNAME_TOOL=$FM_RTK_TEST_SYSTEM_ROOT/usr/bin/uname ;;
  esac
  TEST_SHA=${FM_RTK_TEST_SHA256:-}
  case "$TEST_SHA" in *[!0-9a-f]*) TEST_SHA= ;; esac
  if [ "${#TEST_SHA}" -eq 64 ]; then RTK_BINARY_SHA256=$TEST_SHA; fi
fi

trusted_tool() { [ -f "$1" ] && [ ! -L "$1" ] && [ -x "$1" ]; }
usage() {
  printf '%s\n' \
    "fm-rtk.sh - verify the pinned private RTK artifact without executing it." \
    "" \
    "Usage:" \
    "  fm-rtk.sh verify"
}
refuse() {
  printf 'fm-rtk: refused request: %s\n' "$1" >&2
  exit 64
}

case "${1:-}" in -h|--help) [ "$#" -eq 1 ] || refuse 'help accepts no arguments'; usage; exit 0 ;; esac
[ "$#" -eq 1 ] && [ "$1" = verify ] || refuse 'only the argument verify is accepted'
trusted_tool "$UNAME_TOOL" && trusted_tool "$PERL_TOOL" || {
  printf 'fm-rtk: trusted system utility unavailable\n' >&2
  exit 69
}
OS_NAME=$($UNAME_TOOL -s 2>/dev/null) || OS_NAME=
ARCH_NAME=$($UNAME_TOOL -m 2>/dev/null) || ARCH_NAME=
if [ "$OS_NAME" != Darwin ] || [ "$ARCH_NAME" != arm64 ]; then
  printf 'fm-rtk: unsupported platform (requires Darwin arm64)\n' >&2
  exit 69
fi
EFFECTIVE_HOME=${FM_HOME:-$FM_ROOT}
case "$EFFECTIVE_HOME" in /*) ;; *) printf 'fm-rtk: invalid absolute FM_HOME\n' >&2; exit 65 ;; esac

"$PERL_TOOL" -MDigest::SHA -MFcntl=:DEFAULT -e '
  use strict;
  use warnings;
  my ($home, $pin, $platform, $expected) = @ARGV;
  my $directory_flags = O_RDONLY | O_NOFOLLOW | O_DIRECTORY;
  my $file_flags = O_RDONLY | O_NOFOLLOW | O_NONBLOCK;
  sysopen(my $directory, "/", $directory_flags) or exit 1;
  my @home = split m{/}, $home, -1;
  shift @home;
  @home = grep { length } @home;
  exit 1 if !@home || grep { $_ eq "." || $_ eq ".." } @home;

  sub enter {
    my ($parent, $name, $flags) = @_;
    chdir($parent) or exit 1;
    sysopen(my $child, $name, $flags) or exit 1;
    return $child;
  }

  for my $component (@home) {
    $directory = enter($directory, $component, $directory_flags);
  }
  for my $component ("data", "tools", "rtk", $pin, $platform) {
    $directory = enter($directory, $component, $directory_flags);
  }
  my $artifact = enter($directory, "rtk", $file_flags);
  my @identity = stat($artifact);
  exit 1 unless @identity && -f _ && ($identity[2] & 0111);
  binmode($artifact) or exit 1;
  my $digest = Digest::SHA->new(256);
  $digest->addfile($artifact);
  exit 1 unless $digest->hexdigest eq $expected;
  exit 0;
' "$EFFECTIVE_HOME" "$RTK_PIN" "$RTK_PLATFORM" "$RTK_BINARY_SHA256"
case $? in
  0) printf 'fm-rtk: verified RTK v0.45.0 artifact (not executed)\n'; exit 0 ;;
  *) printf 'fm-rtk: artifact verification failed\n' >&2; exit 65 ;;
esac
